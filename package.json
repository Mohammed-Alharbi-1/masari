{
  "name": "masari",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run validate:catalog && npm run validate:questionnaire && npm run validate:roadmap && npm run validate:learning-resources && npm run validate:progress && npm run validate:security && vite build",
    "validate:catalog": "node scripts/validate-catalog.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "validate:questionnaire": "node scripts/validate-questionnaire.ts",
    "validate:roadmap": "node scripts/validate-roadmap.ts",
    "validate:learning-resources": "node scripts/validate-learning-resources.ts",
    "validate:progress": "node scripts/validate-progress.ts",
    "validate:security": "node scripts/validate-security.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.8",
    "gsap": "3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.4"
  }
}
